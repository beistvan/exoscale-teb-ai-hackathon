# GreenOps challenge run credentials — copy to .env and fill in from the
# runner page (API credentials → Copy environment). NEVER commit .env.
# These are per-run simulation credentials, not real cloud keys.

EXOSCALE_API_KEY=EXO...
EXOSCALE_API_SECRET=...
GREENOPS_CLOUD_ENDPOINT=https://greenops.containerstack.net/runs/<run-id>/cloud/v2
GREENOPS_GRID_SECRET=...
GREENOPS_GRID_ENDPOINT=https://greenops.containerstack.net/runs/<run-id>/grid/v4
GREENOPS_WORK_ENDPOINT=https://greenops.containerstack.net/runs/<run-id>/work/v1
